GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/vibemail-gmail-notifications
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3001
CRON_SECRET=

# ---- Web client (Next.js at the root: app/, components/, lib/ …) ----
# Phase 1 runs on the sample data in data/data.js. Set to "api" once the engine serves
# CONTRACT.md §4 (Phase 2).
NEXT_PUBLIC_DATA_SOURCE=sample
# The engine's origin, e.g. http://localhost:3000 under `vercel dev`. FRONTEND_URL above must be
# the web client's origin (CORS and the /auth/callback redirect).
NEXT_PUBLIC_API_URL=
# The Supabase project the engine signs users in to. The anon key is public; the web client uses
# it only to keep, refresh and sign out its own session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
