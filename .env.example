GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/vibemail-gmail-notifications
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3001
CRON_SECRET=

# ---- Web client ----
# One Next.js project serves the web client and the engine on one origin (npm run web:dev:
# http://localhost:3001), so FRONTEND_URL and the GOOGLE_REDIRECT_URI origin above are that origin.
# The Supabase project the engine signs users in to. The anon key is public; the web client uses
# it only to keep, refresh and sign out its own session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
