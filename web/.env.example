# The VibeMail Engine origin (no trailing slash), e.g. http://localhost:3000 with `vercel dev`.
VITE_API_URL=http://localhost:3000
# The Supabase project the engine signs users in to. The anon key is public by design; the
# frontend uses it only to refresh and sign out its own session.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
